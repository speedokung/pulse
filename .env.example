# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave both empty to run in demo mode with example Pulses around central Bangkok.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Any MapLibre style URL. Default is OpenFreeMap (free, no key needed).
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Optional. Where the map opens when the visitor's location is unavailable (lat,lng).
VITE_DEFAULT_CENTER=13.7383,100.5410

# Optional. LINE LIFF app ID (LINE Developers → your LINE Login channel → LIFF). Enables "Link LINE",
# LINE alerts and sharing cards inside LINE. See README → LINE.
VITE_LIFF_ID=
